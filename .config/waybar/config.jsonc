{
    "reload_style_on_change": true,
  //"output": ["HDMI-A-1"],
  "spacing": 4,
  "height": 34,
  "modules-left": [
      "hyprland/workspaces",
      "cava",
      "mpris",
      "network"
    //"hyprland/mode",
  ],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    //"custom/weather",
    "pulseaudio",
    "custom/brightness",
    "custom/hyprpicker",
    "custom/updates",
    "clock",
    "tray"
  ],
  // Modules configuration
  "hyprland/workspaces": {
      "format": "{icon}",
      "format-icons": {
          "active": " ",
          "default": " ",
          "empty": " ",
          "urgent": "! "
      },
      "persistent-workspaces": {
          "*": [1, 2, 3, 4, 5]
      }
  },

  "hyprland/window": {
      "format": "{title}",
      "max-length": 30,
      "all-outputs": true,
      "format-empty": "Welcome!"
  },

  "network": {
      "interface": "wlo1", //depens of your wifi interface, use `ip link` to find it
      "format": "{ifname}",
      "format-wifi": "{ipaddr}  ",
      "format-ethernet": "{ifname}  ",
      "format-disconnected": " ",
      "tooltip-format": "{ifname}",
      "tooltip-format-wifi": "{essid} ({signalStrength}%)  ",
      "tooltip-format-ethernet": "{ifname} ",
      "tooltip-format-disconnected": "Disconnected",
      "max-length": 45
  },
  "custom/brightness": {
      "format": " {text}%",
      "signal": 8,
      "exec": "~/.config/waybar/brightness-control.sh get",
      "on-scroll-up": "~/.config/waybar/brightness-control.sh up",
      "on-scroll-down": "~/.config/waybar/brightness-control.sh down",
      "on-click": "~/.config/waybar/brightness-control.sh left_click",
      "on-click-right":  "~/.config/waybar/brightness-control.sh right_click",
      "tooltip": false
  },
  "custom/hyprpicker": {
      "exec": "printf '󰈊 '",
      "interval": "once",
      "tooltip": true,
      "tooltip-format": "Seleccionar color",
      "on-click": "hyprpicker -a"
  },
  "custom/updates": {
      "exec": "bash ~/.config/waybar/updates-count.sh",
      "return-type": "json",
      "format": "{text}",
      "interval": 1800,
      "hide-empty": true,
      "tooltip": true
  },
  "cava": {
    //"cava_config": "$XDG_CONFIG_HOME/cava/config",
    "framerate": 30,
    "autosens": 1,
    "bars": 12,
    "lower_cutoff_freq": 50,
    "higher_cutoff_freq": 10000,
    "method": "pulse",
    "source": "auto",
    "stereo": true,
    "bar_delimiter": 0,
    "noise_reduction": 0.77,
    "input_delay": 2,
    "hide_on_silence": true,
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "actions": {
        "on-click-right": "mode"
    }
  },
  "mpris": {
    //"player": "firefox",
    "format": "{status_icon} {dynamic}  ",
    "format-paused": "{status_icon} <i>{dynamic}</i>  ",
    "interval": 1,
    "dynamic-len": 20,
    "status-icons": {
        "playing": "▶",
        "paused": "⏸",
        "stopped": ""
    },
    "dynamic-order": ["title", "artist"]
    //"ignored-players": ["firefox"]
  },
  "hyprland/mode": {
      "format": "{}"
  },
  "tray": {
      "icon-size": 14,
      "spacing": 10
  },
  "load": {
      "format": " {}"
  },
  "clock": {
      "timezone": "America/Santiago",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "format": " {:%H:%M}",
      "format-alt": " {:%a %F}"
  },
  "custom/weather": {
      "format": "{}°",
      "tooltip": true,
      "interval": 3600,
      "exec": "wttrbar --lang es -m --nerd",
      "return-type": "json"
  },
  "pulseaudio": {
      "scroll-step": 5,
      "format": "{icon} {volume}%",
      "format-bluetooth": "{icon} {volume}% ",
      "format-bluetooth-muted": "x {icon}",
      "format-muted": "x 0%",
      "format-icons": {
          "headphone": "",
          "hands-free": "󰂑",
          "headset": "󰂑",
          "phone": "",
          "portable": "",
          "car": "",
          "default": ["", "", ""]
      },
      "on-click": "pactl set-sink-mute 0 toggle",
      "on-click-right": "pavucontrol"
  }
}
